# Copy to .env.local (git-ignored) and fill in. Restart `npm run dev` after editing.
VITE_USE_MOCKS=false

# Google AI Studio key: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
VITE_GEMMA_MODEL=gemma-4-31b-it

# Spotify app (https://developer.spotify.com/dashboard). Server-side only, no VITE_ prefix.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Spotify dashboard > your app > Settings > Redirect URIs must include:
#   http://127.0.0.1:5173/callback
